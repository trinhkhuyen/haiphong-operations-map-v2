# Local smoke test: DOMAIN=:80 and WEB_ORIGIN=http://localhost
# VPS: set DOMAIN to the DNS name pointing at this server, for example map.example.vn.
DOMAIN=:80
WEB_ORIGIN=http://localhost

POSTGRES_DB=hnth
POSTGRES_USER=hnth
# Use URL-safe alphanumeric characters in this value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change_this_db_password_7f3c9a2e

JWT_SECRET=change_this_to_a_long_random_jwt_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
HNTH_AGENT_TOKEN=change_this_agent_token
HNTH_DEFAULT_AGENT_ID=hnth-haiphong-01

# Empty means same-origin `/api` through Caddy. Do not put `/api` here.
VITE_HNTH_BACKEND_URL=

