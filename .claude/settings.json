{
  "permissions": {
    "allow": [
      "Bash(pnpm check*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm build*)",
      "Bash(pnpm smoke*)",
      "Bash(pnpm test*)",
      "Bash(pnpm --filter @haiphong-ops/web test*)",
      "Bash(node --test *)",
      "Bash(pnpm --filter @haiphong-ops/web typecheck*)",
      "Bash(pnpm --filter @haiphong-ops/web build*)",
      "Bash(node scripts/check.mjs*)",
      "Bash(node scripts/smoke-backend.mjs*)",
      "Bash(node --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(docker compose --env-file .env.source -f docker-compose.source.yml ps*)",
      "Bash(docker compose --env-file .env.source -f docker-compose.source.yml logs*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm --filter @haiphong-ops/hnth-agent build:windows*)"
    ],
    "deny": [
      "Read(./.env.production)",
      "Read(./.env.source)",
      "Read(./.env.demo)",
      "Read(./.codex_tmp/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(docker compose * down -v*)",
      "Bash(docker volume rm*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.mjs\"",
            "timeout": 120,
            "statusMessage": "Kiểm tra cú pháp/typecheck…"
          }
        ]
      }
    ]
  }
}
