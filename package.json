{
  "name": "haiphong-ops-map",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @haiphong-ops/web dev",
    "build": "pnpm --filter @haiphong-ops/web build",
    "typecheck": "pnpm --filter @haiphong-ops/web typecheck",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --build --test",
    "test": "pnpm --filter @haiphong-ops/web test && pnpm --filter @haiphong-ops/hnth-protocol test && pnpm --filter @haiphong-ops/hnth-backend test && pnpm --filter @haiphong-ops/hnth-agent test",
    "test:e2e": "node --test \"scripts/e2e/*.test.mjs\"",
    "smoke:backend": "node scripts/smoke-backend.mjs"
  }
}
